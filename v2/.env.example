# Copy required values to project root .env. Never put API keys in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
# Required for all external data/AI access. Optional for direct localhost only.
COCKPIT_ACCESS_TOKEN=
# Defaults to data/songwol_demo.db, shared with the existing sample repository.
# SONGWOL_DB_PATH=
